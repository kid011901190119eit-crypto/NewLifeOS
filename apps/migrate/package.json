{
  "name": "@lifeos/migrate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node --env-file-if-exists=../../deploy/compose/.env dist/main.js"
  },
  "dependencies": {
    "@lifeos/core": "workspace:*",
    "@lifeos/db": "workspace:*",
    "@lifeos/registry": "workspace:*"
  },
  "devDependencies": {
    "@lifeos/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
