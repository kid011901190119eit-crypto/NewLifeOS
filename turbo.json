{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "clean"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@lifeos/core#test": {
      "dependsOn": ["^build", "build"]
    },
    "@lifeos/finance#test": {
      "dependsOn": ["^build", "build"]
    },
    "@lifeos/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/deploy/compose/**"]
    },
    "@lifeos/config#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/renovate.json",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/deploy/compose/**",
        "$TURBO_ROOT$/packages/db/src/testing/ryuk-image.ts"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "//#lint:deps": {
      "dependsOn": [
        "@lifeos/core#build",
        "@lifeos/db#build",
        "@lifeos/finance#build",
        "@lifeos/registry#build"
      ],
      "cache": false
    },
    "//#prettier:check": {
      "cache": false
    },
    "//#prettier:write": {
      "cache": false
    }
  }
}
