{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "//#lint:deps": {
      "dependsOn": ["@lifeos/core#build"],
      "cache": false
    },
    "//#prettier:check": {
      "cache": false
    },
    "//#prettier:write": {
      "cache": false
    }
  }
}
