{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "clean"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@lifeos/config#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/renovate.json",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/deploy/compose/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "//#lint:deps": {
      "dependsOn": ["@lifeos/core#build"],
      "cache": false
    },
    "//#prettier:check": {
      "cache": false
    },
    "//#prettier:write": {
      "cache": false
    }
  }
}
