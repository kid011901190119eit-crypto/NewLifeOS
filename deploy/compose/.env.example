# ローカル開発用の環境変数の見本。このファイルを同じフォルダの .env に複製し、パスワードを書き換えて使う。
# .env は .gitignore で除外している。本物の値をこのファイルに書かない。

POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lifeos
# 手元で別の PostgreSQL が 5432 を使っているときは変える
POSTGRES_PORT=5432

VALKEY_PASSWORD=change-me-local-only
# 手元で別の Redis/Valkey が 6379 を使っているときは変える
VALKEY_PORT=6379

# migrate コマンド(apps/migrate)が使う接続先。上の POSTGRES_* と同じ値にする(ずれるとテストが失敗する)
DATABASE_URL=postgres://lifeos:change-me-local-only@127.0.0.1:5432/lifeos
