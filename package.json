{
  "name": "lifeos",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint lint:deps",
    "lint:deps": "depcruise \"packages/*/src\" \"packages/modules/*/src\" \"apps/*/src\" --config .dependency-cruiser.mjs",
    "format": "turbo run prettier:write",
    "format:check": "turbo run prettier:check",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "db:up": "docker compose -f deploy/compose/compose.yaml up -d --wait",
    "db:down": "docker compose -f deploy/compose/compose.yaml down",
    "db:status": "docker compose -f deploy/compose/compose.yaml ps",
    "db:logs": "docker compose -f deploy/compose/compose.yaml logs -f",
    "db:reset": "docker compose -f deploy/compose/compose.yaml down --volumes && docker compose -f deploy/compose/compose.yaml up -d --wait"
  },
  "devDependencies": {
    "@lifeos/config": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
